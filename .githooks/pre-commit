#!/bin/sh
# Pre-commit checks
set -e

echo "[pre-commit] Checking Rust formatting..."
cargo fmt --all -- --check

echo "[pre-commit] Running Clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "[pre-commit] Running tests..."
cargo test --workspace -q

echo "[pre-commit] TypeScript typecheck..."
pnpm typecheck

echo "[pre-commit] TypeScript/Vue lint and SDK tests..."
pnpm lint
pnpm test

echo "[pre-commit] OK"
