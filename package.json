{
  "name": "geo-rs",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @geo-rs/site dev",
    "build": "pnpm --filter @geo-rs/core build && pnpm --filter @geo-rs/vue build && pnpm --filter @geo-rs/site build",
    "typecheck": "pnpm --filter @geo-rs/core build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test && pnpm test:tooling",
    "test:tooling": "node --test .github/scripts/bench-compare.test.mjs"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3",
    "vue-eslint-parser": "^10.4.1"
  }
}
